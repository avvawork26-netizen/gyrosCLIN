# Supabase project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never expose to the browser.
# Used by API routes to validate employee PINs and run privileged operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
